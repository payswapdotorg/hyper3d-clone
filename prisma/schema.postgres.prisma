generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String
  passwordHash String
  balance      Int           @default(40) // reference free tier starts at 40 credits
  preferences  Json?
  referralCode String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        Task[]
  likes        Like[]
  creditEntries CreditEntry[]
}

model Task {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String // "RodinAgentic" | "RodinStandard"
  prompt          String
  step            String        @default("ModelGenerate")
  userState       String        @default("created")
  spec            Json?
  inputImageUrl   String?
  previewImageUrl String?
  modelUrl        String?
  videoUrl        String?
  usage           Json?
  settings        Json?
  creditsSpent    Int           @default(0)
  isFeatured      Boolean       @default(false)
  isPrivate       Boolean       @default(false)
  error           String?
  generationUuid  String?
  generateTime    DateTime?
  posterBytes     Bytes? // rasterized poster PNG (deployment adaptation: blob-in-DB so serverless has no filesystem dependency)
  inputBytes      Bytes? // uploaded reference image bytes
  // ---- engine2 recovery build: free neural engine + pay-by-result ----
  engine          String? // requested tier at creation: "neural" | "fast"
  engineUsed      String? // engine that actually produced the result: "neural" | "fast"
  fallbackReason  String? // why the neural path fell back to the fast engine
  seed            Int?    // generation seed (0..65535), shown on the card for reproducibility
  meshBytes       Bytes?  // stored neural GLB (decimated ≤2MB, painted) — pay-by-result preview
  confirmedAt     DateTime? // set by the confirm gate (exactly 1 credit, exports unlock)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  creditEntries   CreditEntry[]
  // ---- Task 48 backend audit: real gallery (search / sort / likes / pagination) ----
  title           String? // gallery display title ("Scout Mech")
  tags            Json? // gallery tag chips (string[])
  likeCount       Int           @default(0) // denormalized like total (seeded with reference-visible counts)
  galleryImage    String? // static gallery art override (/images/gallery-*.png); falls back to the poster render
  likes           Like[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, taskId]) // one like per user per task — the toggle is idempotent
  @@index([taskId])
}

model CreditEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
